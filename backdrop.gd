class_name Backdrop
extends Node2D

# One pixel-art battlefield tile, generated by code (no image files needed).
# biome: 0 Greenland, 1 Mudland, 2 Rocky Mountain, 3 Hell, 4 Space.
# The picture is W x H "big pixels" stretched to SIZE with nearest-neighbour
# filtering, so it stays crisp. The tile is mirrored by BackdropGrid, so its
# edges never need to match. The texture is built once per biome and shared.
const SIZE := Vector2(1920, 1080)
const W := 384
const H := 216
const BAYER := [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5]

static var _cache: Dictionary = {}

var biome: int = 0
var _img: Image
var _mask: PackedByteArray          # 1 = water / lava / blocked (nothing is placed there)
var _rng := RandomNumberGenerator.new()

func _init() -> void:
	texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	modulate = Color(0.86, 0.86, 0.86)      # slightly dimmed so units stand out

func _draw() -> void:
	draw_texture_rect(_texture(), Rect2(Vector2.ZERO, SIZE), false)

func _texture() -> ImageTexture:
	if not _cache.has(biome):
		_cache[biome] = _build()
	return _cache[biome] as ImageTexture

func _build() -> ImageTexture:
	_img = Image.create(W, H, false, Image.FORMAT_RGBA8)
	_mask = PackedByteArray()
	_mask.resize(W * H)
	_rng.seed = 1000 + biome * 7919
	match biome:
		0:
			_garden()
		1:
			_mud()
		2:
			_rocks()
		3:
			_hell()
		_:
			_space()
	return ImageTexture.create_from_image(_img)

# ---------- helpers ----------

func _col(hex: String) -> Color:
	return Color.html(hex)

func _noise(freq: float, octaves: int, seed_off: int) -> FastNoiseLite:
	var n := FastNoiseLite.new()
	n.noise_type = FastNoiseLite.TYPE_SIMPLEX_SMOOTH
	n.seed = 1000 + biome * 31 + seed_off
	n.frequency = freq
	n.fractal_octaves = octaves
	return n

func _n01(n: FastNoiseLite, x: int, y: int) -> float:
	return clampf(0.5 + 0.5 * n.get_noise_2d(float(x), float(y)) * 1.4, 0.0, 1.0)

func _px(x: int, y: int, c: Color) -> void:
	if x >= 0 and y >= 0 and x < W and y < H:
		_img.set_pixel(x, y, c)

func _shade(x: int, y: int, k: float) -> void:
	if x >= 0 and y >= 0 and x < W and y < H:
		var c := _img.get_pixel(x, y)
		_img.set_pixel(x, y, c.darkened(k) if k > 0.0 else c.lightened(-k))

func _free(x: int, y: int) -> bool:
	return x >= 0 and y >= 0 and x < W and y < H and _mask[y * W + x] == 0

func _mark(x: int, y: int) -> void:
	_mask[y * W + x] = 1

# Picks a colour from a list by value 0..1, dithering between neighbours (pixel-art gradient).
func _tone(v: float, cols: Array, x: int, y: int) -> Color:
	var n := cols.size()
	var f := clampf(v, 0.0, 0.999) * float(n - 1)
	var i := int(f)
	var frac := f - float(i)
	var thr: float = (float(BAYER[(y & 3) * 4 + (x & 3)]) + 0.5) / 16.0
	var a: Color = cols[i]
	var b: Color = cols[i + 1]
	return b if frac > thr else a

func _ellipse(cx: int, cy: int, rx: int, ry: int, c: Color) -> void:
	for y in range(-ry, ry + 1):
		for x in range(-rx, rx + 1):
			if float(x * x) / float(rx * rx) + float(y * y) / float(ry * ry) <= 1.0:
				_px(cx + x, cy + y, c)

func _shadow(cx: int, cy: int, rx: int, ry: int, k: float) -> void:
	for y in range(-ry, ry + 1):
		for x in range(-rx, rx + 1):
			if float(x * x) / float(rx * rx) + float(y * y) / float(ry * ry) <= 1.0:
				_shade(cx + x, cy + y, k)

func _stamp(spr: PackedStringArray, pal: Dictionary, x: int, y: int) -> void:
	for j in spr.size():
		var row: String = spr[j]
		for i in row.length():
			var ch: String = row[i]
			if ch != ".":
				_px(x + i, y + j, pal[ch] as Color)

func _ri(a: int, b: int) -> int:
	return _rng.randi_range(a, b)

# Random walk of single pixels (cracks, rivers of dirt, ...).
func _walk(x0: int, y0: int, steps: int, c: Color, only_free: bool = true) -> void:
	var x := x0
	var y := y0
	var dx := _ri(-1, 1)
	var dy := _ri(-1, 1)
	for i in steps:
		if _rng.randf() < 0.25:
			dx = _ri(-1, 1)
			dy = _ri(-1, 1)
		x += dx
		y += dy
		if not only_free or _free(x, y):
			_px(x, y, c)

# Positions sorted top to bottom so nearer sprites overlap farther ones.
func _spots(count: int, margin: int = 10) -> Array:
	var out: Array = []
	for i in count:
		var x := _ri(margin, W - margin)
		var y := _ri(margin, H - margin)
		if _free(x, y):
			out.append(Vector2i(x, y))
	out.sort_custom(func(a: Vector2i, b: Vector2i) -> bool: return a.y < b.y)
	return out

# ---------- Greenland ----------

const TREE := ["....GGGG.....", "..GGGLLGGG...", ".GGLLLGGGGG..", "GGLLGGGGGGGG.", "GGGGGGGGGGDG.", ".GGGGGGGGDDG.", "..GGGGGDDDG..", "...DDDDDDD...", ".....TT......", ".....TT......", ".....TT......"]
const BUSH := ["..GGGG...", ".GLLGGG..", "GLGGGGDG.", "GGGGGDDG.", ".DDDDDD.."]

func _garden() -> void:
	var grass := [_col("2f6b2c"), _col("3a8236"), _col("479a40"), _col("58b04c")]
	var sand := [_col("d8c98a"), _col("c9b873")]
	var water := [_col("2f78c4"), _col("4a95dd")]
	var n1 := _noise(0.011, 3, 1)
	var n2 := _noise(0.07, 2, 2)
	var nw := _noise(0.016, 3, 3)
	for y in H:
		for x in W:
			var v := _n01(n1, x, y) * 0.75 + _n01(n2, x, y) * 0.25
			var w := _n01(nw, x, y)
			if w > 0.7:
				_px(x, y, _tone(_n01(n2, x, y), water, x, y))
				_mark(x, y)
			elif w > 0.655:
				_px(x, y, _tone(_n01(n2, x, y), sand, x, y))
			else:
				_px(x, y, _tone(v, grass, x, y))
	# grass tufts
	for i in 700:
		var x := _ri(2, W - 3)
		var y := _ri(3, H - 2)
		if _free(x, y) and _img.get_pixel(x, y).g > 0.4:
			_px(x, y, _col("2a5f28"))
			_px(x, y - 1, _col("6cc45a"))
	# flowers
	var petals := [_col("ffffff"), _col("ffe14a"), _col("ff7fa8"), _col("c78cff")]
	for i in 180:
		var x := _ri(3, W - 4)
		var y := _ri(3, H - 4)
		if _free(x, y) and _img.get_pixel(x, y).g > 0.4:
			var p: Color = petals[_ri(0, petals.size() - 1)]
			_px(x - 1, y, p)
			_px(x + 1, y, p)
			_px(x, y - 1, p)
			_px(x, y + 1, p)
			_px(x, y, _col("ffcf2e"))
	# water sparkles
	for i in 90:
		var x := _ri(2, W - 3)
		var y := _ri(2, H - 3)
		if not _free(x, y):
			_px(x, y, _col("bfe3ff"))
			_px(x + 1, y, _col("bfe3ff"))
	var pal := {"G": _col("3f9a3c"), "L": _col("6cc45a"), "D": _col("2a6a2a"), "T": _col("6b4423")}
	for p: Vector2i in _spots(34):
		_stamp(PackedStringArray(BUSH), pal, p.x - 4, p.y - 4)
	for p: Vector2i in _spots(30):
		_shadow(p.x + 1, p.y + 1, 6, 2, 0.32)
		_stamp(PackedStringArray(TREE), pal, p.x - 6, p.y - 10)
	# drifting cloud shadows
	for i in 6:
		_shadow(_ri(20, W - 20), _ri(15, H - 15), _ri(22, 40), _ri(9, 16), 0.12)

# ---------- Mudland ----------

const DEAD_TREE := ["...T...T...", "...TT.TT...", "....TTT....", ".T..TT..T..", ".TT.TT.TT..", "..TTTTTT...", "....TT.....", "....TT.....", "....TT.....", "...TTTT...."]
const REEDS := ["R..R.", "RR.R.", ".RRR.", ".RR..", ".R..."]

func _mud() -> void:
	var mud := [_col("4a3524"), _col("5c4630"), _col("705a3d"), _col("85704c")]
	var pud := [_col("2e3a2c"), _col("3d5240")]
	var moss := [_col("5c4630"), _col("5f6a34"), _col("7d8a3f")]
	var n1 := _noise(0.013, 3, 1)
	var n2 := _noise(0.08, 2, 2)
	var np := _noise(0.02, 3, 3)
	var nm := _noise(0.03, 2, 4)
	for y in H:
		for x in W:
			var v := _n01(n1, x, y) * 0.7 + _n01(n2, x, y) * 0.3
			var p := _n01(np, x, y)
			var m := _n01(nm, x, y)
			if p > 0.68:
				_px(x, y, _tone(_n01(n2, x, y), pud, x, y))
				_mark(x, y)
			elif p > 0.64:
				_px(x, y, _col("2c2218"))
			elif m > 0.66:
				_px(x, y, _tone((m - 0.66) * 3.0, moss, x, y))
			else:
				_px(x, y, _tone(v, mud, x, y))
	for i in 34:
		_walk(_ri(5, W - 5), _ri(5, H - 5), _ri(14, 34), _col("2c2218"))
	# puddle shine and bubbles
	for i in 140:
		var x := _ri(2, W - 4)
		var y := _ri(2, H - 3)
		if not _free(x, y):
			_px(x, y, _col("8fb08a"))
			_px(x + 1, y, _col("8fb08a"))
	for i in 24:
		var x := _ri(4, W - 6)
		var y := _ri(4, H - 6)
		if not _free(x, y):
			_px(x, y, _col("c0d6b8"))
			_px(x + 1, y + 1, _col("c0d6b8"))
	# pebbles
	for i in 160:
		var x := _ri(2, W - 3)
		var y := _ri(2, H - 3)
		if _free(x, y):
			_px(x, y, _col("9a8566"))
			_px(x + 1, y, _col("3a2b1c"))
	var pal := {"T": _col("3b2a1c"), "R": _col("7a8a3a")}
	for p: Vector2i in _spots(60):
		_stamp(PackedStringArray(REEDS), pal, p.x - 2, p.y - 4)
	for p: Vector2i in _spots(18):
		_shadow(p.x + 2, p.y + 1, 6, 2, 0.35)
		_stamp(PackedStringArray(DEAD_TREE), pal, p.x - 5, p.y - 9)

# ---------- Rocky Mountain ----------

const PINE := ["....S....", "...GSG...", "...GGG...", "..GGSGG..", "..GGGGG..", ".GGSGGGG.", ".GGGGGGG.", "GGGSGGGGG", "GGGGGGGGG", "....T....", "....T...."]
const BOULDER := ["...LLLL....", ".LLLLLMMM..", "LLLMMMMMMM.", "LLMMMMMMDD.", "MMMMMMMDDD.", ".MMMMDDDDD.", "..DDDDDDD.."]

func _rocks() -> void:
	var stone := [_col("4a4f5c"), _col("5d6371"), _col("737a89"), _col("8a91a0")]
	var snow := [_col("c9d6e6"), _col("e8f0f8"), _col("ffffff")]
	var ice := [_col("7fb4d6"), _col("a8d4ec")]
	var n1 := _noise(0.012, 3, 1)
	var n2 := _noise(0.09, 2, 2)
	var ns := _noise(0.017, 3, 3)
	var ni := _noise(0.025, 2, 4)
	for y in H:
		for x in W:
			var v := _n01(n1, x, y) * 0.65 + _n01(n2, x, y) * 0.35
			var s := _n01(ns, x, y)
			var ic := _n01(ni, x, y)
			if ic > 0.74:
				_px(x, y, _tone(_n01(n2, x, y), ice, x, y))
				_mark(x, y)
			elif s > 0.6:
				_px(x, y, _tone(_n01(n2, x, y) * 0.8 + (s - 0.6), snow, x, y))
			elif s > 0.55:
				_px(x, y, _tone((s - 0.55) * 20.0, [stone[2], snow[0]], x, y))
			else:
				_px(x, y, _tone(v, stone, x, y))
	for i in 30:
		_walk(_ri(5, W - 5), _ri(5, H - 5), _ri(12, 30), _col("2e323c"))
	for i in 20:
		var x := _ri(4, W - 5)
		var y := _ri(4, H - 5)
		if not _free(x, y):
			_walk(x, y, 8, _col("e8f4ff"), false)
	for i in 220:
		var x := _ri(2, W - 3)
		var y := _ri(2, H - 3)
		if _free(x, y):
			_px(x, y, _col("9aa2b2"))
			_px(x + 1, y + 1, _col("3a3f4a"))
	var pal := {"S": _col("f2f8ff"), "G": _col("2f5a4a"), "T": _col("4a3320"), "L": _col("9aa2b2"), "M": _col("737a89"), "D": _col("4a4f5c")}
	for p: Vector2i in _spots(26):
		_shadow(p.x + 3, p.y + 1, 7, 2, 0.3)
		_stamp(PackedStringArray(BOULDER), pal, p.x - 5, p.y - 6)
	for p: Vector2i in _spots(26):
		_shadow(p.x + 1, p.y + 1, 6, 2, 0.3)
		_stamp(PackedStringArray(PINE), pal, p.x - 4, p.y - 10)

# ---------- Hell ----------

const SPIKE := ["...K...", "...KK..", "..KLK..", "..KLKK.", ".KKLKK.", ".KKLKKK", "KKKKKKK"]
const SKULL := [".WWWWW.", "WWWWWWW", "WKWWWKW", "WKWWWKW", ".WWKWW.", ".WWWWW.", "..W.W.."]

func _hell() -> void:
	var rock := [_col("1c1216"), _col("2a171b"), _col("3a1d1f"), _col("4d2623")]
	var glowrock := [_col("3a1d1a"), _col("5a2a1c")]
	var lava := [_col("b83a16"), _col("d8581c"), _col("f09a2a")]
	var n1 := _noise(0.012, 3, 1)
	var n2 := _noise(0.08, 2, 2)
	var nr := _noise(0.008, 3, 3)
	for y in H:
		for x in W:
			var v := _n01(n1, x, y) * 0.7 + _n01(n2, x, y) * 0.3
			var r := absf(nr.get_noise_2d(float(x), float(y)))
			if r < 0.02:
				_px(x, y, _tone(_n01(n2, x, y) * 0.6 + 0.4, lava, x, y))
				_mark(x, y)
			elif r < 0.042:
				_px(x, y, _tone(_n01(n2, x, y), [lava[0], lava[1]], x, y))
				_mark(x, y)
			elif r < 0.065:
				_px(x, y, _tone(_n01(n2, x, y), glowrock, x, y))
			else:
				_px(x, y, _tone(v, rock, x, y))
	# glowing cracks
	for i in 7:
		_walk(_ri(5, W - 5), _ri(5, H - 5), _ri(14, 30), _col("a8401a"))
	# ember specks and ash
	for i in 140:
		var x := _ri(1, W - 2)
		var y := _ri(1, H - 2)
		if _free(x, y):
			_px(x, y, [_col("ff8a2a"), _col("d8451a"), _col("5c3a34")][_ri(0, 2)])
	var pal := {"K": _col("14101c"), "L": _col("6a4a9a"), "W": _col("d8d0c0")}
	for p: Vector2i in _spots(34):
		_shadow(p.x + 2, p.y + 1, 5, 2, 0.4)
		_stamp(PackedStringArray(SPIKE), pal, p.x - 3, p.y - 6)
	var pal_s := {"K": _col("2a171b"), "W": _col("c9c0ae")}
	for p: Vector2i in _spots(16):
		_stamp(PackedStringArray(SKULL), pal_s, p.x - 3, p.y - 3)

# ---------- Space ----------

func _space() -> void:
	var bg := [_col("05060f"), _col("0a0b1f"), _col("120f2e")]
	var neb1 := [_col("0a0b1f"), _col("2a1650"), _col("4a2a86")]
	var neb2 := [_col("0a0b1f"), _col("0f2e55"), _col("1f5a9a")]
	var n1 := _noise(0.008, 3, 1)
	var n2 := _noise(0.011, 3, 2)
	var n3 := _noise(0.05, 2, 3)
	for y in H:
		for x in W:
			var a := _n01(n1, x, y)
			var b := _n01(n2, x, y)
			var c := _tone(_n01(n3, x, y) * 0.5, bg, x, y)
			if a > 0.52:
				c = _tone((a - 0.52) * 2.4 * (0.6 + 0.6 * _n01(n3, x, y)), neb1, x, y)
			elif b > 0.56:
				c = _tone((b - 0.56) * 2.4 * (0.6 + 0.6 * _n01(n3, x, y)), neb2, x, y)
			_px(x, y, c)
	# stars
	var tints := [_col("ffffff"), _col("cfe0ff"), _col("ffe9b0"), _col("ffc0c0")]
	for i in 520:
		var x := _ri(0, W - 1)
		var y := _ri(0, H - 1)
		var t: Color = tints[_ri(0, tints.size() - 1)]
		_px(x, y, t.darkened(_rng.randf_range(0.0, 0.6)))
	for i in 46:
		var x := _ri(4, W - 5)
		var y := _ri(4, H - 5)
		var t: Color = tints[_ri(0, tints.size() - 1)]
		_px(x, y, Color.WHITE)
		_px(x - 1, y, t.darkened(0.45))
		_px(x + 1, y, t.darkened(0.45))
		_px(x, y - 1, t.darkened(0.45))
		_px(x, y + 1, t.darkened(0.45))
	# planets
	_planet(70, 52, 22, [_col("1b2a5a"), _col("2f5aa8"), _col("4f90d8"), _col("a8d8ff")], false)
	_planet(300, 150, 15, [_col("4a1810"), _col("8a3a20"), _col("c8683a"), _col("f0a870")], true)
	_planet(210, 40, 8, [_col("2a2a36"), _col("55556a"), _col("8a8aa0"), _col("c0c0d6")], false)
	# asteroids
	var rock := [_col("2e2e3a"), _col("55556a"), _col("8a8aa0")]
	for i in 22:
		var cx := _ri(8, W - 8)
		var cy := _ri(8, H - 8)
		var r := _ri(2, 5)
		for dy in range(-r, r + 1):
			for dx in range(-r, r + 1):
				if float(dx * dx + dy * dy) <= float(r * r) * _rng.randf_range(0.7, 1.15):
					var l := clampf(0.5 - float(dx + dy) / float(r * 4), 0.0, 1.0)
					_px(cx + dx, cy + dy, _tone(l, rock, cx + dx, cy + dy))

func _planet(cx: int, cy: int, r: int, cols: Array, ringed: bool) -> void:
	if ringed:
		for dy in range(-r, r + 1):
			for dx in range(-r * 2, r * 2 + 1):
				var e := float(dx * dx) / float(r * r * 3.0) + float(dy * dy) / float(r * r * 0.18)
				if e >= 0.8 and e <= 1.0:
					_px(cx + dx, cy + dy, _col("d8c8a0") if e < 0.9 else _col("a89870"))
	for dy in range(-r, r + 1):
		for dx in range(-r, r + 1):
			var d2 := float(dx * dx + dy * dy)
			if d2 <= float(r * r):
				var nz := sqrt(1.0 - d2 / float(r * r))
				var light := clampf(0.5 - (float(dx) * 0.55 + float(dy) * 0.65) / float(r) * 0.5 + nz * 0.15, 0.0, 1.0)
				_px(cx + dx, cy + dy, _tone(light, cols, cx + dx, cy + dy))
	if ringed:
		for dy in range(1, r + 1):
			for dx in range(-r * 2, r * 2 + 1):
				var e := float(dx * dx) / float(r * r * 3.0) + float(dy * dy) / float(r * r * 0.18)
				if e >= 0.8 and e <= 1.0:
					_px(cx + dx, cy + dy, _col("d8c8a0") if e < 0.9 else _col("a89870"))
