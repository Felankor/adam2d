class_name Backdrop
extends Node2D

# One pixel-art battlefield tile, generated by code (no image files needed).
# biome: 0 Greenland, 1 Mudland, 2 Rocky Mountain, 3 Hell, 4 Space.
#
# The ground has DEPTH: it is a little height map. Raised plateaus show a lit lip and a
# south-facing cliff wall, ponds and lava rivers are sunk below the ground (you see the bank
# wall inside them), everything casts a soft shadow towards the lower right (the light comes from
# the upper left), and trees, rocks and spikes are shaded spheres/prisms with the same light.
# It is still the same top-down camera and the same pixel-art look.
#
# The picture is W x H "big pixels" stretched to SIZE with nearest-neighbour filtering. It is
# periodic (it repeats seamlessly, WITHOUT mirroring, so the light never flips). Building one takes
# a moment, so it runs on a background thread (Backdrop.request) and is polled by BackdropGrid.
const SIZE := Vector2(1920, 1080)
const W := 384
const H := 216
const BAYER := [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5]
const BASE_COLORS := [Color(0.23, 0.51, 0.21), Color(0.36, 0.27, 0.19), Color(0.36, 0.39, 0.44), Color(0.16, 0.09, 0.11), Color(0.04, 0.04, 0.12)]

static var _cache: Dictionary = {}          # biome -> ImageTexture
static var _jobs: Dictionary = {}           # biome -> Thread
static var _solids: Dictionary = {}         # biome -> PackedByteArray: 1 where the ground is water / lava / ice
const WORLD_PX := 7.5                       # world units per picture pixel (SIZE / W x the grid's tile scale)
const FREQ_SCALE := 0.65                    # < 1: bigger, calmer shapes (less visual noise)

var biome: int = 0
var _shown_biome: int = -2
var _img: Image
var _solid: PackedByteArray
var _mask: PackedByteArray          # 1 = water / lava / cliff and the area next to it (nothing is placed there)
var _rng := RandomNumberGenerator.new()

func _init() -> void:
	texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	modulate = Color(0.86, 0.86, 0.86)      # slightly dimmed so units stand out

# ---------- building on a thread ----------

static func request(b: int) -> void:
	if _cache.has(b) or _jobs.has(b):
		return
	var th := Thread.new()
	_jobs[b] = th
	th.start(_job.bind(b))

static func _job(b: int) -> Dictionary:
	var bd := Backdrop.new()
	bd.biome = b
	var img := bd._build()
	var out := {"img": img, "solid": bd._solid}
	bd.free()
	return out

# True when the ground at this world position is water, lava or ice (walking units go around it).
static func liquid_at(b: int, p: Vector2) -> bool:
	var s: PackedByteArray = _solids.get(b, PackedByteArray())
	if s.is_empty():
		return false
	var x := posmod(floori(p.x / WORLD_PX), W)
	var y := posmod(floori(p.y / WORLD_PX), H)
	return s[y * W + x] == 1

# Call every frame: turns finished images into textures. True when a new one is ready.
static func poll() -> bool:
	var changed := false
	for b in _jobs.keys():
		var th: Thread = _jobs[b]
		if not th.is_alive():
			var res: Dictionary = th.wait_to_finish()
			_jobs.erase(b)
			if res.has("img"):
				_cache[b] = ImageTexture.create_from_image(res["img"] as Image)
				_solids[b] = res["solid"] as PackedByteArray
				changed = true
	return changed

func refresh() -> void:
	if _shown_biome != biome and _cache.has(biome):
		queue_redraw()

func _draw() -> void:
	if _cache.has(biome):
		draw_texture_rect(_cache[biome] as ImageTexture, Rect2(Vector2.ZERO, SIZE), false)
		_shown_biome = biome
	else:
		draw_rect(Rect2(Vector2.ZERO, SIZE), BASE_COLORS[clampi(biome, 0, BASE_COLORS.size() - 1)])

func _build() -> Image:
	_img = Image.create(W, H, false, Image.FORMAT_RGBA8)
	_mask = PackedByteArray()
	_mask.resize(W * H)
	_solid = PackedByteArray()
	_solid.resize(W * H)
	_rng.seed = 1000 + biome * 7919
	match biome:
		0:
			_garden()
		1:
			_mud()
		2:
			_rocks()
		3:
			_hell()
		_:
			_space()
	return _img

# ---------- helpers ----------

func _col(hex: String) -> Color:
	return Color.html(hex)

func _pal(hexes: Array) -> Array:
	var out: Array = []
	for hx in hexes:
		out.append(Color.html(str(hx)))
	return out

func _ix(x: int, y: int) -> int:
	return posmod(y, H) * W + posmod(x, W)

func _px(x: int, y: int, c: Color) -> void:
	_img.set_pixel(posmod(x, W), posmod(y, H), c)

func _shade(x: int, y: int, k: float) -> void:
	var xx := posmod(x, W)
	var yy := posmod(y, H)
	_img.set_pixel(xx, yy, _img.get_pixel(xx, yy).darkened(k))

func _blend(x: int, y: int, c: Color, a: float) -> void:
	var xx := posmod(x, W)
	var yy := posmod(y, H)
	_img.set_pixel(xx, yy, _img.get_pixel(xx, yy).lerp(c, a))

func _ri(a: int, b: int) -> int:
	return _rng.randi_range(a, b)

# Noise that repeats every W x H pixels (four shifted samples blended), scaled to 0..1.
func _pnoise(freq: float, octaves: int, seed_off: int) -> PackedFloat32Array:
	var n := FastNoiseLite.new()
	n.noise_type = FastNoiseLite.TYPE_SIMPLEX_SMOOTH
	n.seed = 1000 + biome * 31 + seed_off
	n.frequency = freq * FREQ_SCALE
	n.fractal_octaves = octaves
	var out := PackedFloat32Array()
	out.resize(W * H)
	var lo := 1000000.0
	var hi := -1000000.0
	for y in H:
		var fy := float(y) / float(H)
		for x in W:
			var fx := float(x) / float(W)
			var a := n.get_noise_2d(float(x), float(y))
			var b := n.get_noise_2d(float(x - W), float(y))
			var c := n.get_noise_2d(float(x), float(y - H))
			var d := n.get_noise_2d(float(x - W), float(y - H))
			var v := (a * (1.0 - fx) + b * fx) * (1.0 - fy) + (c * (1.0 - fx) + d * fx) * fy
			out[y * W + x] = v
			lo = minf(lo, v)
			hi = maxf(hi, v)
	var span := maxf(hi - lo, 0.0001)
	for i in out.size():
		out[i] = (out[i] - lo) / span
	return out

func _mix(a: PackedFloat32Array, wa: float, b: PackedFloat32Array, wb: float) -> PackedFloat32Array:
	var out := PackedFloat32Array()
	out.resize(W * H)
	for i in out.size():
		out[i] = a[i] * wa + b[i] * wb
	return out

# Periodic 5-point blur, k times.
func _blur(a: PackedFloat32Array, k: int) -> PackedFloat32Array:
	var cur := a.duplicate()
	var nxt := PackedFloat32Array()
	nxt.resize(W * H)
	for pass_i in k:
		for y in H:
			var y0 := y * W
			var ym := ((y - 1 + H) % H) * W
			var yp := ((y + 1) % H) * W
			for x in W:
				var xm := (x - 1 + W) % W
				var xp := (x + 1) % W
				nxt[y0 + x] = (cur[y0 + x] + cur[ym + x] + cur[yp + x] + cur[y0 + xm] + cur[y0 + xp]) * 0.2
		cur = nxt.duplicate()
	return cur

# The value below which a share p (0..1) of the array lies: terrain shares do not depend on the noise's range.
func _quantile(a: PackedFloat32Array, p: float) -> float:
	var s := a.duplicate()
	s.sort()
	return s[clampi(int(p * float(s.size() - 1)), 0, s.size() - 1)]

# Rounds the plateau levels off so tiny islands and speckles disappear.
func _clean(lvl: PackedInt32Array, k: int) -> PackedInt32Array:
	var pos := PackedFloat32Array()
	pos.resize(W * H)
	for i in pos.size():
		pos[i] = float(maxi(lvl[i], 0))
	var sm := _blur(pos, k)
	var out := lvl.duplicate()
	for i in out.size():
		if lvl[i] >= 0:
			out[i] = roundi(sm[i])
	return out

# Picks a colour from a list by value 0..1, dithering between neighbours (pixel-art gradient).
func _tone(v: float, cols: Array, x: int, y: int) -> Color:
	var n := cols.size()
	var f := clampf(v, 0.0, 0.999) * float(n - 1)
	var i := int(f)
	var frac := f - float(i)
	var thr: float = (float(BAYER[(y & 3) * 4 + (x & 3)]) + 0.5) / 16.0
	var a: Color = cols[i]
	var b: Color = cols[i + 1]
	return b if frac > thr else a

func _free(x: int, y: int) -> bool:
	return _mask[_ix(x, y)] == 0 and _mask[_ix(x, y + 3)] == 0

# Positions sorted top to bottom so nearer sprites overlap farther ones.
func _spots(count: int, margin: int = 10) -> Array:
	var out: Array = []
	for i in count:
		var x := _ri(margin, W - margin)
		var y := _ri(margin, H - margin)
		if _free(x, y):
			out.append(Vector2i(x, y))
	out.sort_custom(func(a: Vector2i, b: Vector2i) -> bool: return a.y < b.y)
	return out

# ---------- depth: the terrain renderer ----------
# lvl: -1 sunk (water, lava, ice), 0 ground, 1.. raised plateaus. h: smooth height (for slope light),
# det: fine detail noise. cfg: pals (per level), liq, wall, lip, ch (wall height), shadow,
# wall_dark, shore + shore_t (sandy bank), glow (light cast by the liquid).

func _terrain(h: PackedFloat32Array, det: PackedFloat32Array, lvl: PackedInt32Array, cfg: Dictionary) -> void:
	var pals: Array = cfg["pals"]
	var liq: Array = cfg["liq"]
	var wall_pal: Array = cfg["wall"]
	var lip: Color = cfg["lip"]
	var ch: int = int(cfg.get("ch", 3))
	var shadow := float(cfg.get("shadow", 0.38))
	var wall_dark := float(cfg.get("wall_dark", 0.0))
	var shore: Array = cfg.get("shore", [])
	var shore_t := float(cfg.get("shore_t", 0.3))
	var has_glow: bool = cfg.has("glow")
	var glow: Color = cfg.get("glow", Color.WHITE)
	var liqm := PackedFloat32Array()
	var nonliq := PackedFloat32Array()
	liqm.resize(W * H)
	nonliq.resize(W * H)
	for i in W * H:
		liqm[i] = 1.0 if lvl[i] < 0 else 0.0
		nonliq[i] = 1.0 - liqm[i]
	var near := _blur(liqm, 3)
	var nl := _blur(nonliq, 2)
	for y in H:
		for x in W:
			var i := y * W + x
			var L: int = lvl[i]
			var gx := (h[_ix(x + 1, y)] - h[_ix(x - 1, y)]) * 0.5
			var gy := (h[_ix(x, y + 1)] - h[_ix(x, y - 1)]) * 0.5
			var light := clampf(-(gx + gy) * 9.0, -0.28, 0.28)
			var bv := clampf(det[i] * 0.45 + 0.22 + light, 0.0, 1.0)
			var c: Color
			if L < 0:
				c = _tone(clampf(det[i] * 0.4 + 0.2 + nl[i] * 0.4, 0.0, 1.0), liq, x, y)
			else:
				var pal: Array = pals[mini(L, pals.size() - 1)]
				c = _tone(bv, pal, x, y)
				if L == 0 and shore.size() > 0 and near[i] > shore_t:
					c = _tone(bv, shore, x, y)
			# a cliff wall: higher ground a few pixels to the north, and we see its south face
			var wd := 0
			for d in range(1, ch * 3 + 1):
				var up: int = lvl[_ix(x, y - d)]
				if up > L and (up - L) * ch >= d:
					wd = d
					break
			var is_wall := wd > 0
			if is_wall:
				var stri := (sin(float(x) * 1.7) + sin(float(x) * 0.53 + 3.0)) * 0.5
				var wv := clampf(0.6 - 0.08 * float(wd) + stri * 0.08 + det[i] * 0.08 - wall_dark, 0.0, 1.0)
				c = _tone(wv, wall_pal, x, y)
			if L >= 0 and L > lvl[_ix(x, y + 1)]:
				c = c.lerp(lip, 0.6)                   # the sunlit lip of the plateau
			if not is_wall:
				for k in range(1, 5):
					var up2: int = lvl[_ix(x - k, y - k)]
					if up2 > L and (up2 - L) * 2 + 1 >= k:
						c = c.darkened(shadow)         # shadow cast to the lower right
						break
			if has_glow and L >= 0:
				c = c.lerp(glow, 0.5 * clampf(near[i] * 1.6, 0.0, 1.0))
			_img.set_pixel(x, y, c)
			if L < 0:
				_solid[i] = 1
			if L < 0 or is_wall:
				_mask[i] = 1
	# keep props off the banks too
	var mf := PackedFloat32Array()
	mf.resize(W * H)
	for i in W * H:
		mf[i] = float(_mask[i])
	var mb := _blur(mf, 2)
	for i in W * H:
		_mask[i] = 1 if mb[i] > 0.04 else 0

# ---------- 3D-shaded props (light from the upper left) ----------

# A ball lit from the upper left; band = flat colour bands (rock) instead of dithering (leaves).
func _sphere(cx: int, cy: int, rx: int, ry: int, pal: Array, band: bool = false) -> void:
	for dy in range(-ry, ry + 1):
		for dx in range(-rx, rx + 1):
			var e := float(dx * dx) / float(rx * rx) + float(dy * dy) / float(ry * ry)
			if e <= 1.0:
				var nz := sqrt(1.0 - e)
				var nx := float(dx) / float(rx)
				var ny := float(dy) / float(ry)
				var light := clampf(0.5 - (nx * 0.55 + ny * 0.7) * 0.5 + nz * 0.22, 0.0, 0.999)
				if band:
					_px(cx + dx, cy + dy, pal[mini(int(light * float(pal.size() - 1) + 0.5), pal.size() - 1)])
				else:
					_px(cx + dx, cy + dy, _tone(light, pal, cx + dx, cy + dy))

# Soft shadow thrown to the lower right.
func _cast(cx: int, cy: int, rx: int, ry: int, k: float, sx: float) -> void:
	var span := int(float(rx) * 1.6)
	for dy in range(-ry, ry + 1):
		for dx in range(-span, span + 1):
			var e := (float(dx) / 1.6) * (float(dx) / 1.6) / float(rx * rx) + float(dy * dy) / float(ry * ry)
			if e <= 1.0:
				_shade(cx + int(float(rx) * sx) + dx, cy + dy + 1, k)

# Darkening right under a prop (ambient occlusion).
func _ao(cx: int, cy: int, rx: int, ry: int, k: float) -> void:
	for dy in range(-ry, ry + 1):
		for dx in range(-rx, rx + 1):
			if float(dx * dx) / float(rx * rx) + float(dy * dy) / float(ry * ry) <= 1.0:
				_shade(cx + dx, cy + dy, k)

func _tree(x: int, y: int, trunk: Array, g: Array) -> void:
	_cast(x, y, 7, 2, 0.35, 1.1)
	_ao(x, y, 5, 2, 0.3)
	for j in 7:
		_px(x - 1, y - j, trunk[0])
		_px(x, y - j, trunk[1])
		_px(x + 1, y - j, trunk[2])
	_sphere(x + 1, y - 9, 6, 5, g)
	_sphere(x - 3, y - 11, 5, 4, g)
	_sphere(x + 4, y - 12, 4, 4, g)
	_sphere(x, y - 14, 5, 4, g)

func _bush(x: int, y: int, g: Array) -> void:
	_cast(x, y, 4, 1, 0.3, 0.9)
	_sphere(x, y - 2, 4, 3, g)
	_sphere(x - 3, y - 1, 3, 2, g)
	_sphere(x + 3, y - 1, 3, 2, g)

func _dead_tree(x: int, y: int, c: Array) -> void:
	_cast(x, y, 6, 2, 0.38, 1.0)
	_ao(x, y, 3, 1, 0.35)
	for j in 10:
		_px(x - 1, y - j, c[1])
		_px(x, y - j, c[0])
		if j < 6:
			_px(x + 1, y - j, c[2])
	for o in [Vector2i(-1, -10), Vector2i(-2, -11), Vector2i(-3, -12), Vector2i(-3, -13), Vector2i(1, -10), Vector2i(2, -11), Vector2i(3, -12), Vector2i(3, -13), Vector2i(0, -11), Vector2i(0, -12), Vector2i(-1, -6), Vector2i(-2, -7), Vector2i(-3, -8), Vector2i(2, -6), Vector2i(3, -7)]:
		var v: Vector2i = o
		_px(x + v.x, y + v.y, c[0] if v.x <= 0 else c[2])

func _reeds(x: int, y: int, c: Array) -> void:
	var stalks := [Vector2i(-2, 5), Vector2i(-1, 7), Vector2i(0, 6), Vector2i(1, 8), Vector2i(2, 5)]
	for s in stalks:
		var v: Vector2i = s
		for j in v.y:
			_px(x + v.x, y - j, c[0] if j < v.y - 1 else c[1])

func _boulder(x: int, y: int, pal: Array) -> void:
	_cast(x, y, 7, 2, 0.4, 1.0)
	_ao(x, y, 6, 2, 0.3)
	_sphere(x, y - 3, 6, 4, pal, true)
	for i in 3:
		_px(x + _ri(-3, 3), y + _ri(-5, 0), pal[0])

func _pine(x: int, y: int, g: Array, snow: Array, trunk: Color) -> void:
	_cast(x, y, 6, 2, 0.36, 1.1)
	_ao(x, y, 4, 1, 0.35)
	for j in 3:
		_px(x, y - j, trunk)
	var tiers := [Vector2i(y - 3, 7), Vector2i(y - 7, 6), Vector2i(y - 11, 5), Vector2i(y - 15, 3)]
	for t in tiers:
		var tv: Vector2i = t
		for r in 5:
			var w := maxi(tv.y - r, 0)
			for dx in range(-w, w + 1):
				var c: Color
				if float(dx) < -float(w) * 0.3:
					c = g[3]
				elif float(dx) < float(w) * 0.3:
					c = g[2]
				else:
					c = g[1]
				if r >= 3 and dx < 0:
					c = snow[1]
				if r == 4:
					c = snow[0] if dx <= 0 else snow[1]
				_px(x + dx, tv.x - r, c)

func _spike(x: int, y: int, pal: Array, glow: Color, hgt: int) -> void:
	_cast(x, y, 5, 2, 0.45, 0.9)
	_ao(x, y, 4, 1, 0.4)
	for j in hgt:
		var w := int(float(hgt - j) / float(hgt) * 3.2)
		for dx in range(-w, w + 1):
			var c: Color = pal[2] if dx < 0 else pal[0]
			if dx == 0:
				c = pal[1]
			_px(x + dx, y - j, c)
	_px(x, y - hgt, glow)
	_px(x, y - hgt + 1, glow)

func _skull(x: int, y: int) -> void:
	var bone := _col("d8d0c0")
	var dark := _col("8a8070")
	var k := _col("14101c")
	_cast(x, y, 3, 1, 0.4, 0.8)
	for dy in range(-3, 2):
		for dx in range(-3, 4):
			if absi(dx) == 3 and (dy == -3 or dy == 1):
				continue                       # rounded corners
			_px(x + dx, y + dy, bone if dx <= 1 else dark)
	_px(x - 2, y - 1, k)
	_px(x - 1, y - 1, k)
	_px(x + 1, y - 1, k)
	_px(x + 2, y - 1, k)
	_px(x, y, k)
	_px(x - 1, y + 1, k)
	_px(x + 1, y + 1, k)

# ---------- Greenland ----------

func _garden() -> void:
	var n1 := _pnoise(0.011, 3, 1)
	var n2 := _pnoise(0.07, 2, 2)
	var nw := _pnoise(0.016, 3, 3)
	var h := _blur(_mix(n1, 0.85, n2, 0.15), 1)
	var lvl := PackedInt32Array()
	lvl.resize(W * H)
	var q1 := _quantile(h, 0.66)
	var q2 := _quantile(h, 0.92)
	for i in W * H:
		lvl[i] = 2 if h[i] > q2 else (1 if h[i] > q1 else 0)
	lvl = _clean(lvl, 3)
	var nwb := _blur(nw, 2)
	var qw := _quantile(nwb, 0.93)
	for i in W * H:
		if nwb[i] > qw:
			lvl[i] = -1
	_terrain(h, n2, lvl, {
		"pals": [_pal(["2f6b2c", "3a8236", "479a40", "58b04c"]), _pal(["3f7f34", "4c9a3c", "5fb048", "78c85a"]), _pal(["5a8a3a", "6fa344", "86bc52", "a4d86a"])],
		"liq": _pal(["2f78c4", "4a95dd", "7ab8ee"]),
		"wall": _pal(["3a2a1a", "57402a", "7a5a38", "946f45"]),
		"lip": _col("a6d870"), "ch": 3,
		"shore": _pal(["d8c98a", "c9b873", "e0d49a"]), "shore_t": 0.28,
	})
	var leaves := _pal(["1f4f22", "2a6a2a", "3f9a3c", "6cc45a", "a4e87a"])
	var trunk := _pal(["8a5a30", "6b4423", "4a2e18"])
	for p: Vector2i in _spots(18):
		_bush(p.x, p.y, leaves)
	for p: Vector2i in _spots(18):
		_tree(p.x, p.y, trunk, leaves)
	var petals := [_col("ffffff"), _col("ffe14a"), _col("ff7fa8"), _col("c78cff")]
	for i in 60:
		var x := _ri(3, W - 4)
		var y := _ri(3, H - 4)
		if _mask[_ix(x, y)] == 0:
			var pc: Color = petals[_ri(0, petals.size() - 1)]
			_px(x - 1, y, pc)
			_px(x + 1, y, pc)
			_px(x, y - 1, pc)
			_px(x, y + 1, pc)
			_px(x, y, _col("ffcf2e"))

# ---------- Mudland ----------

func _mud() -> void:
	var n1 := _pnoise(0.013, 3, 1)
	var n2 := _pnoise(0.08, 2, 2)
	var npool := _pnoise(0.02, 3, 3)
	var nm := _pnoise(0.03, 2, 4)
	var nr := _pnoise(0.012, 3, 5)
	var h := _blur(_mix(n1, 0.85, n2, 0.15), 1)
	var lvl := PackedInt32Array()
	lvl.resize(W * H)
	var rb := _blur(nr, 2)
	var qr := _quantile(rb, 0.78)
	for i in W * H:
		lvl[i] = 1 if rb[i] > qr else 0
	lvl = _clean(lvl, 3)
	var pb := _blur(npool, 2)
	var qp := _quantile(pb, 0.92)
	for i in W * H:
		if pb[i] > qp:
			lvl[i] = -1
	_terrain(h, n2, lvl, {
		"pals": [_pal(["4a3524", "5c4630", "705a3d", "85704c"]), _pal(["6a5236", "7d6542", "957a50", "ad9060"])],
		"liq": _pal(["26331f", "33452b", "46603a"]),
		"wall": _pal(["2a1f14", "3e2d1c", "5a432b", "735838"]),
		"lip": _col("b09a68"), "ch": 3, "wall_dark": 0.05,
	})
	# moss on the low ground
	var qm := _quantile(nm, 0.75)
	var moss := _pal(["5c4630", "5f6a34", "7d8a3f"])
	for y in H:
		for x in W:
			var i := y * W + x
			if nm[i] > qm and lvl[i] == 0:
				_blend(x, y, _tone(clampf((nm[i] - qm) * 4.0, 0.0, 1.0), moss, x, y), 0.65)
	var reed := [_col("6a7a30"), _col("8a9a40")]
	for p: Vector2i in _spots(34):
		_reeds(p.x, p.y, reed)
	var wood := [_col("5a4128"), _col("7a5a38"), _col("33231a")]
	for p: Vector2i in _spots(12):
		_dead_tree(p.x, p.y, wood)
	var stone := _pal(["3a2b1c", "5c4630", "85704c", "a89870"])
	for p: Vector2i in _spots(10):
		_boulder(p.x, p.y, stone)

# ---------- Rocky Mountain ----------

func _rocks() -> void:
	var n1 := _pnoise(0.012, 3, 1)
	var n2 := _pnoise(0.09, 2, 2)
	var ni := _pnoise(0.025, 2, 4)
	var h := _blur(_mix(n1, 0.85, n2, 0.15), 1)
	var lvl := PackedInt32Array()
	lvl.resize(W * H)
	var q1 := _quantile(h, 0.60)
	var q2 := _quantile(h, 0.85)
	var q3 := _quantile(h, 0.95)
	for i in W * H:
		lvl[i] = 3 if h[i] > q3 else (2 if h[i] > q2 else (1 if h[i] > q1 else 0))
	lvl = _clean(lvl, 3)
	var nib := _blur(ni, 2)
	var qi := _quantile(nib, 0.95)
	for i in W * H:
		if nib[i] > qi:
			lvl[i] = -1
	_terrain(h, n2, lvl, {
		"pals": [_pal(["3a3f4a", "4a4f5c", "5d6371", "737a89"]), _pal(["4a4f5c", "5d6371", "737a89", "8a91a0"]), _pal(["5d6371", "737a89", "8a91a0", "aab2c0"]), _pal(["a8b6c8", "c9d6e6", "e8f0f8", "ffffff"])],
		"liq": _pal(["5a9cc4", "7fb4d6", "a8d4ec"]),
		"wall": _pal(["2e323c", "3e4350", "565c6c", "6e7585"]),
		"lip": _col("dbe6f2"), "ch": 3,
	})
	var rock := _pal(["4a4f5c", "5d6371", "8a91a0", "b8c0cc"])
	for p: Vector2i in _spots(12):
		_boulder(p.x, p.y, rock)
	var needles := _pal(["1c3a30", "2f5a4a", "3f7a5e", "4f9a74"])
	var snow := [_col("f2f8ff"), _col("c9d6e6")]
	for p: Vector2i in _spots(16):
		_pine(p.x, p.y, needles, snow, _col("4a3320"))

# ---------- Hell ----------

func _hell() -> void:
	var n1 := _pnoise(0.012, 3, 1)
	var n2 := _pnoise(0.08, 2, 2)
	var nr := _pnoise(0.008, 3, 3)
	var nq := _pnoise(0.011, 3, 4)
	var h := _blur(_mix(n1, 0.85, n2, 0.15), 1)
	var lvl := PackedInt32Array()
	lvl.resize(W * H)
	var hq := _blur(nq, 2)
	var qh := _quantile(hq, 0.76)
	for i in W * H:
		lvl[i] = 1 if hq[i] > qh else 0
	lvl = _clean(lvl, 3)
	# lava rivers: a thin band around the middle value of a smooth noise
	var med := _quantile(nr, 0.5)
	var rr := PackedFloat32Array()
	rr.resize(W * H)
	for i in W * H:
		rr[i] = absf(nr[i] - med)
	var qlava := _quantile(rr, 0.08)
	for i in W * H:
		if rr[i] < qlava:
			lvl[i] = -1
	_terrain(h, n2, lvl, {
		"pals": [_pal(["1c1216", "2a171b", "3a1d1f", "4d2623"]), _pal(["2a171b", "3a1d1f", "4d2623", "66322a"])],
		"liq": _pal(["b83a16", "d8581c", "f09a2a", "ffc850"]),
		"wall": _pal(["120a0e", "22121a", "38201f", "55302a"]),
		"lip": _col("c85a30"), "ch": 3, "glow": _col("ff6a1c"),
	})
	var crystal := _pal(["14101c", "3a2a5a", "6a4a9a"])
	for p: Vector2i in _spots(18):
		_spike(p.x, p.y, crystal, _col("ff8a2a"), _ri(7, 12))
	for p: Vector2i in _spots(8):
		_skull(p.x, p.y)
	var embers := [_col("ff8a2a"), _col("d8451a"), _col("5c3a34")]
	for i in 90:
		var x := _ri(1, W - 2)
		var y := _ri(1, H - 2)
		if _mask[_ix(x, y)] == 0:
			_px(x, y, embers[_ri(0, 2)])

# ---------- Space ----------

func _space() -> void:
	var bg := _pal(["05060f", "0a0b1f", "120f2e"])
	var neb1 := _pal(["0a0b1f", "2a1650", "4a2a86", "7a4ac0"])
	var neb2 := _pal(["0a0b1f", "0f2e55", "1f5a9a", "3a8ad8"])
	var n1 := _pnoise(0.008, 3, 1)
	var n2 := _pnoise(0.011, 3, 2)
	var n3 := _pnoise(0.05, 2, 3)
	var n4 := _pnoise(0.02, 3, 4)
	var q1 := _quantile(n1, 0.45)
	var q2 := _quantile(n2, 0.55)
	var cloud := PackedByteArray()
	cloud.resize(W * H)
	for y in H:
		for x in W:
			var i := y * W + x
			var c := _tone(n3[i] * 0.5, bg, x, y)
			var k := 0.6 + 0.6 * n3[i]
			if n1[i] > q1:
				cloud[i] = 1
				c = _tone(clampf((n1[i] - q1) * 1.6 * k, 0.0, 1.0), neb1, x, y)
			elif n2[i] > q2:
				c = _tone(clampf((n2[i] - q2) * 1.6 * k, 0.0, 1.0), neb2, x, y)
			_img.set_pixel(x, y, c)
	# the lit rim of the near nebula (upper left), and a dark dust lane in front for layering
	for y in H:
		for x in W:
			var i := y * W + x
			if cloud[i] == 1 and cloud[_ix(x - 1, y)] == 0:
				_blend(x, y, _col("b898ff"), 0.25)
			if absf(n4[i] - 0.5) < 0.022:
				_shade(x, y, 0.3)
	var tints := [_col("ffffff"), _col("cfe0ff"), _col("ffe9b0"), _col("ffc0c0")]
	for i in 520:
		var t: Color = tints[_ri(0, tints.size() - 1)]
		_px(_ri(0, W - 1), _ri(0, H - 1), t.darkened(_rng.randf_range(0.0, 0.6)))
	for i in 46:
		var x := _ri(4, W - 5)
		var y := _ri(4, H - 5)
		var t: Color = tints[_ri(0, tints.size() - 1)]
		_px(x, y, Color.WHITE)
		_px(x - 1, y, t.darkened(0.45))
		_px(x + 1, y, t.darkened(0.45))
		_px(x, y - 1, t.darkened(0.45))
		_px(x, y + 1, t.darkened(0.45))
	_planet(70, 52, 22, _pal(["0a1030", "1b2a5a", "2f5aa8", "4f90d8", "a8d8ff"]), false, _col("7ab8ff"), 0.0)
	_planet(300, 150, 15, _pal(["2a0e0a", "4a1810", "8a3a20", "c8683a", "f0a870"]), true, _col("ffb070"), 1.1)
	_planet(210, 40, 8, _pal(["15151c", "2a2a36", "55556a", "8a8aa0", "c0c0d6"]), false, Color(0, 0, 0, 0), 0.0)
	for i in 22:
		_asteroid(_ri(8, W - 8), _ri(8, H - 8), _ri(2, 5))

# A lit globe: terminator on the lower right, a glowing atmosphere rim on the lit side.
func _planet(cx: int, cy: int, r: int, pal: Array, ringed: bool, atm: Color, bands: float) -> void:
	var has_atm := atm.a > 0.0
	if ringed:
		_planet_ring(cx, cy, r, false)
	if has_atm:
		for dy in range(-r - 3, r + 4):
			for dx in range(-r - 3, r + 4):
				var d := sqrt(float(dx * dx + dy * dy))
				if d > float(r) and d <= float(r + 3):
					_blend(cx + dx, cy + dy, atm, 0.35 * (1.0 - (d - float(r)) / 3.0))
	for dy in range(-r, r + 1):
		for dx in range(-r, r + 1):
			var d2 := float(dx * dx + dy * dy)
			if d2 <= float(r * r):
				var nz := sqrt(1.0 - d2 / float(r * r))
				var light := 0.5 - (float(dx) * 0.55 + float(dy) * 0.65) / float(r) * 0.5 + nz * 0.15
				if bands > 0.0:
					light += 0.08 * sin(float(dy) * bands)
				light = clampf(light - 0.08 * (1.0 - nz), 0.0, 0.999)
				var c := _tone(light, pal, cx + dx, cy + dy)
				if has_atm and nz < 0.35 and (float(dx) * 0.55 + float(dy) * 0.65) < 0.0:
					c = c.lerp(atm, 0.4)
				_px(cx + dx, cy + dy, c)
	if ringed:
		_planet_ring(cx, cy, r, true)

func _planet_ring(cx: int, cy: int, r: int, front: bool) -> void:
	for dy in range(-r, r + 1):
		for dx in range(-r * 2, r * 2 + 1):
			var e := float(dx * dx) / float(r * r * 3.0) + float(dy * dy) / float(r * r * 0.18)
			if e >= 0.8 and e <= 1.0 and ((dy >= 1) == front):
				if front or (dx * dx + dy * dy) > r * r:
					_px(cx + dx, cy + dy, _col("d8c8a0") if e < 0.9 else _col("a89870"))

func _asteroid(cx: int, cy: int, r: int) -> void:
	var pal := _pal(["1c1c28", "2e2e3a", "55556a", "8a8aa0", "b8b8cc"])
	_sphere(cx, cy, r + 1, r, pal)
	for i in maxi(1, r / 2):
		var ox := _ri(-r / 2, r / 2)
		var oy := _ri(-r / 2, r / 2)
		if ox * ox + oy * oy < r * r / 2:
			_px(cx + ox, cy + oy, pal[1])
			_px(cx + ox + 1, cy + oy + 1, pal[3])
