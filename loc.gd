static var _registered: bool = false

static func setup(lang: String) -> void:
	if not _registered:
		_registered = true
		var tr_table := Translation.new()
		tr_table.locale = "tr"
		for key: String in TR:
			tr_table.add_message(key, str(TR[key]))
		TranslationServer.add_translation(tr_table)
	TranslationServer.set_locale(lang)

static func set_language(lang: String) -> void:
	TranslationServer.set_locale(lang)

static func current() -> String:
	return "tr" if TranslationServer.get_locale().begins_with("tr") else "en"

static func t(text: String) -> String:
	return TranslationServer.translate(text)
