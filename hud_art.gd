static var _tex: Dictionary = {}

static func tex(name: String) -> Texture2D:
	if not _tex.has(name):
		var img := Image.new()
		img.load_png_from_buffer(Marshalls.base64_to_raw(DATA[name]))
		_tex[name] = ImageTexture.create_from_image(img)
	return _tex[name]
