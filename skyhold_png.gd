class_name SkyholdPng
extends RefCounted

# Baked pixel-art pictures of the Skyhold hub (hull, buildings, airships, clouds), rendered with the same palettes and
# light as the castles. [width, ground row] per picture; one art pixel = 3 world pixels. Made by the art tool, do not edit.

const META := {"hull": [1480, 300.0], "b_map": [435, 391.5], "b_workshop": [435, 391.5], "b_trader": [450, 315.0], "b_stash": [503, 378.0], "b_yard": [468, 377.0], "radar": [216, 337.5], "turret": [96, 62.4], "ship_a": [270, 170.1], "ship_b": [270, 170.1], "ship_c": [270, 170.1], "cloud0": [165, 0], "cloud1": [189, 0], "cloud2": [213, 0], "cloud3": [237, 0], "cloud4": [261, 0], "cloud5": [286, 0], "cloud6": [310, 0], "cloud7": [334, 0]}
const ANCH := {"hull_flags": [[-569, -213.8], [-569, 63.1], [379, -213.8], [379, 63.1], [574, -67.3]], "map_flag": [0.0, -134.8], "map_ring": [-43.5, -42.3], "workshop_smoke": [[-26.1, -84.4], [40.6, -84.4]], "workshop_flag": [81.2, -30.6], "stash_flags": [[-98.0, -32.2], [98.0, -32.2]], "ship_prop": [-50.0, -4.6]}

const DATA := {
	"hull": "",
	"b_map": "",
	"b_workshop": "",
	"b_trader": "",
	"b_stash": "",
	"b_yard": "",
	"radar": "",
	"turret": "",
	"ship_a": "",
	"ship_b": "",
	"ship_c": "",
	"cloud0": "",
	"cloud1": "",
	"cloud2": "",
	"cloud3": "",
	"cloud4": "",
	"cloud5": "",
	"cloud6": "",
	"cloud7": ""
}

static var _tex: Dictionary = {}

static func tex(name: String) -> Texture2D:
	if not _tex.has(name):
		var img := Image.new()
		img.load_png_from_buffer(Marshalls.base64_to_raw(str(DATA[name])))
		_tex[name] = ImageTexture.create_from_image(img)
	return _tex[name]

static func w(name: String) -> float:
	return float((META[name] as Array)[0])

static func gy(name: String) -> float:
	return float((META[name] as Array)[1])

static func anchor(key: String) -> Vector2:
	var a: Array = ANCH[key]
	return Vector2(float(a[0]), float(a[1]))

static func anchors(key: String) -> Array:
	var out: Array = []
	for a: Array in ANCH[key]:
		out.append(Vector2(float(a[0]), float(a[1])))
	return out
