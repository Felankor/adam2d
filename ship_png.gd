static func has(key: String) -> bool:
	return DATA.has(key)

static func build(key: String, dir: int) -> Dictionary:
	var pair: Array = (DATA[key] as Array)[posmod(dir, 16)]
	var a := Image.new()
	a.load_png_from_buffer(Marshalls.base64_to_raw(pair[0]))
	a.convert(Image.FORMAT_RGBA8)
	var b := Image.new()
	b.load_png_from_buffer(Marshalls.base64_to_raw(pair[1]))
	b.convert(Image.FORMAT_RGBA8)
	return {"imgs": [a], "fimgs": [b], "off": OFF[key]}
