class_name WeaponArt
extends RefCounted

# Draws the baked pixel-art turret of a weapon (see WeaponPng): lit 3D models in the same palettes, light and outline
# as the castles. One art pixel = 3 world pixels, like the mobs. The turret has 24 headings, a recoil frame and, for the
# Gatling Gun, three barrel-spin frames.

const PIXEL := 3.0
# distance from the pivot to the muzzle in world pixels at scale 1: Rifle, Machinegun, Gatling, Rocket, Laser, Void
const TIP := [90.0, 100.0, 93.0, 87.0, 102.0, 110.0]

# generated by sky/muzzle: barrel base (texels, relative to the ground pivot), and per heading the on-screen angle and length of the barrel
const BASE_Y := [-4.0, -4.0, -4.5, -4.5, -4.5, -4.3]
const VIS_A := [[0.0, 0.2253, 0.459, 0.7222, 0.9767, 1.2783, 1.5708, 1.8633, 2.1648, 2.4194, 2.6826, 2.9163, 3.1416, -2.9163, -2.6733, -2.4135, -2.1568, -1.8633, -1.5708, -1.2783, -0.9848, -0.7281, -0.4683, -0.2253], [0.0, 0.2212, 0.4758, 0.7194, 0.9924, 1.2815, 1.5708, 1.8601, 2.1492, 2.4222, 2.6658, 2.9204, 3.1416, -2.9031, -2.6631, -2.4222, -2.1492, -1.8632, -1.5708, -1.2784, -0.9924, -0.7194, -0.4785, -0.2385], [0.0, 0.2496, 0.4939, 0.7504, 1.0066, 1.2806, 1.5708, 1.861, 2.135, 2.3911, 2.6477, 2.8919, 3.1416, -2.9037, -2.6751, -2.4193, -2.1326, -1.858, -1.5708, -1.2836, -1.009, -0.7223, -0.4665, -0.2379], [0.0, 0.2358, 0.4867, 0.7462, 1.0051, 1.2925, 1.5708, 1.8491, 2.1365, 2.3954, 2.6549, 2.9058, 3.1416, -2.9024, -2.6595, -2.4054, -2.1383, -1.8677, -1.5708, -1.2739, -1.0033, -0.7362, -0.4867, -0.2392], [0.0, 0.2318, 0.4746, 0.7363, 0.9963, 1.287, 1.5708, 1.8546, 2.1453, 2.4053, 2.667, 2.9098, 3.1416, -2.9098, -2.6807, -2.4246, -2.1423, -1.8574, -1.5708, -1.2842, -0.9993, -0.717, -0.4609, -0.2318], [0.0, 0.232, 0.4795, 0.7339, 0.9941, 1.2844, 1.5708, 1.8572, 2.1386, 2.4077, 2.6621, 2.9096, 3.1416, -2.9057, -2.673, -2.4182, -2.1444, -1.8443, -1.5708, -1.2973, -0.9972, -0.7234, -0.4685, -0.2359]]
const VIS_L := [[29.4, 29.5, 29.1, 28.0, 27.5, 27.0, 26.4, 27.0, 27.5, 28.0, 29.1, 29.5, 29.4, 29.5, 29.0, 28.4, 27.8, 27.0, 26.4, 27.0, 27.8, 28.4, 29.0, 29.5], [33.4, 33.7, 33.2, 32.2, 31.6, 31.2, 31.1, 31.2, 31.6, 32.2, 33.2, 33.7, 33.4, 33.9, 33.2, 32.2, 31.6, 31.2, 31.1, 31.2, 31.6, 32.2, 33.2, 33.9], [30.4, 31.2, 31.0, 30.4, 30.3, 30.1, 29.8, 30.1, 30.3, 30.4, 31.0, 31.2, 30.4, 31.0, 30.9, 30.3, 29.7, 29.3, 28.9, 29.3, 29.7, 30.3, 30.9, 31.0], [28.5, 29.1, 29.1, 28.9, 28.5, 28.4, 27.8, 28.4, 28.5, 28.9, 29.1, 29.1, 28.5, 29.1, 29.1, 28.7, 28.5, 28.0, 27.8, 28.0, 28.5, 28.7, 29.1, 29.1], [33.2, 33.1, 32.6, 31.7, 30.7, 30.0, 29.8, 30.0, 30.7, 31.7, 32.6, 33.1, 33.2, 33.1, 32.2, 31.0, 30.3, 29.7, 29.7, 29.7, 30.3, 31.0, 32.2, 33.1], [36.4, 37.4, 36.6, 35.7, 34.5, 34.0, 32.7, 34.0, 34.4, 35.7, 36.6, 37.4, 36.4, 37.2, 36.5, 35.4, 34.6, 34.1, 33.9, 34.1, 34.6, 35.4, 36.5, 37.2]]

static func tip(weapon: int, k: float = 1.0) -> float:
	return float(TIP[clampi(weapon, 0, TIP.size() - 1)]) * k

# The heading whose drawn barrel is closest to `angle`.
static func _heading(weapon: int, angle: float) -> int:
	var n := WeaponPng.HEADINGS
	var best := 0
	var bd := 99.0
	var arr: Array = VIS_A[weapon]
	for h in n:
		var d := absf(angle_difference(float(arr[h]), angle))
		if d < bd:
			bd = d
			best = h
	return best

static func _base(weapon: int, pos: Vector2, s: float) -> Vector2:
	return Vector2(roundf(pos.x), roundf(pos.y + float(BASE_Y[weapon]) * s))

# Where shots leave the barrel: on the barrel's own axis, `angle` exactly (the drawn sprite is turned to match it).
static func muzzle(weapon: int, angle: float, pos: Vector2, k: float = 1.0) -> Vector2:
	weapon = clampi(weapon, 0, TIP.size() - 1)
	var s := PIXEL * k
	var h := _heading(weapon, angle)
	return _base(weapon, pos, s) + Vector2.RIGHT.rotated(angle) * float((VIS_L[weapon] as Array)[h]) * s

# `pos` is where the turret stands (its mount), `angle` the aim in radians, `spin` the Gatling turn (any number, 1 = one
# full cycle of its three frames), `k` the size. The baked sprite has 24 headings; it is turned by the small remainder so
# the barrel always points exactly where the shots go. Returns the muzzle.
static func draw(c: CanvasItem, weapon: int, angle: float, pos: Vector2, recoil: bool, spin: float = 0.0, k: float = 1.0) -> Vector2:
	weapon = clampi(weapon, 0, TIP.size() - 1)
	var h := _heading(weapon, angle)
	var phase := 0
	if weapon == 2:
		phase = int(floorf(fposmod(spin, 1.0) * 3.0)) % 3
	var row := WeaponPng.row_of(weapon, 1 if recoil else 0, phase)
	var cell := float(WeaponPng.CELL)
	var s := PIXEL * k
	var src := Rect2(float(h) * cell, float(row) * cell, cell, cell)
	var base := _base(weapon, pos, s)
	var resid := angle_difference(float((VIS_A[weapon] as Array)[h]), angle)
	c.draw_set_transform(base, resid, Vector2.ONE)
	var dst := Rect2(-cell * 0.5 * s, -(float(WeaponPng.GROUND) + float(BASE_Y[weapon])) * s, cell * s, cell * s)
	c.draw_texture_rect_region(WeaponPng.atlas(), dst, src)
	c.draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)
	return base + Vector2.RIGHT.rotated(angle) * float((VIS_L[weapon] as Array)[h]) * s
